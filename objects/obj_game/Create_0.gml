/// obj_game - Create Event


// =====================================================
// UI RESOLUTION
// =====================================================

// Весь GUI работает в координатах 1600x900.
display_set_gui_size(1600, 900);

window_set_size(1600, 900);
window_center();


// =====================================================
// MATERIALS
// =====================================================

global.materials =
    create_materials();


// =====================================================
// RECIPES
// =====================================================

global.recipes =
    create_recipes();


// =====================================================
// DISCOVERED RECIPES / ITEM BOOK
// =====================================================
//
// Здесь хранятся ID открытых рецептов:
//
// "item_01"
// "item_02"
// ...
//
// =====================================================

global.discovered_items = [];


// =====================================================
// CRAFTED ITEM INVENTORY
// =====================================================
//
// ВАЖНО:
//
// Все поля создаём сразу,
// чтобы mini-game могла безопасно делать:
//
// global.item_inventory.item_01 += 1;
//
// =====================================================

global.item_inventory = {
    item_01: 0,
    item_02: 0,
    item_03: 0,
    item_04: 0,
    item_05: 0,

    item_06: 0,
    item_07: 0,
    item_08: 0,
    item_09: 0,
    item_10: 0,

    item_11: 0,
    item_12: 0,
    item_13: 0,
    item_14: 0,
    item_15: 0,

    item_16: 0,
    item_17: 0,
    item_18: 0,
    item_19: 0,
    item_20: 0
};


// =====================================================
// SELECTED RECIPE
// =====================================================

global.selected_recipe = 0;


// =====================================================
// OLD CRAFT RESULT
// =====================================================
//
// Пока оставляем, потому что старые economy/crafting
// объекты могут всё ещё обращаться к этой переменной.
//
// Mini-game использует свой craft_result/craft_note.
//
// =====================================================

global.craft_result =
    "Press CRAFT to create an item.";


// =====================================================
// MATERIAL POOL
// =====================================================
//
// ЕДИНСТВЕННЫЙ запас ресурсов.
//
// Конкретные варианты:
//
// stone_1
// tree_1
// tree_2
// tree_3
//
// используют общий запас своей группы.
//
// Например:
//
// stone_1 -> global.material_pool.stone
// tree_3  -> global.material_pool.tree
//
// =====================================================

global.material_pool = {
    stone:      1000,
    polyester:  800,
    tree:       600,
    cloth:      500,
    glass:      450,
    jewels:     300,
    mushrooms:  150,
    blood:      100
};


// =====================================================
// CRAFT LOG
// =====================================================
//
// Пока оставляем переменные,
// чтобы старый код не падал.
//
// Сам Craft Log позже уберём из UI.
//
// =====================================================

global.craft_log = [];

global.craft_attempts = 0;


// =====================================================
// ECONOMY
// =====================================================

global.credits = 1000;


// =====================================================
// UI SCREEN
// =====================================================
//
// 0 = ECONOMY
// 1 = CRAFT
//
// Пока стартуем с ECONOMY.
//
// Если хочешь, чтобы игра сразу открывала CRAFT,
// поменяй 0 на 1.
//
// =====================================================

global.ui_screen = 1;